<%- include('partials/head') %>
<div class="login-page">
  <form method="POST" action="/register" class="login-card">
    <div class="login-brand">
      <span class="brand-icon" aria-hidden="true">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M3 9l1.5-5h15L21 9" />
          <path d="M3 9a3 3 0 0 0 6 0 3 3 0 0 0 6 0 3 3 0 0 0 6 0" />
          <path d="M5 12v8a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-8" />
          <path d="M9 21v-5a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v5" />
        </svg>
      </span>
      <h1>Sari-Sari POS</h1>
    </div>
    <p class="login-subtitle">Create an account</p>
    <% if (flash && flash.error) { %><div class="alert alert-error" role="alert"><%= flash.error %></div><% } %>

    <label>Full Name
      <input type="text" name="full_name" autocomplete="name" required autofocus />
    </label>
    <label>Username
      <input type="text" name="username" autocomplete="username" required />
    </label>
    <label>Password
      <input type="password" name="password" autocomplete="new-password" required minlength="6" />
    </label>
    <label>Confirm Password
      <input type="password" name="confirm_password" autocomplete="new-password" required minlength="6" />
    </label>
    <label>Account Type
      <select name="role" id="roleSelect">
        <option value="sales_rep">Sales Representative (Cashier)</option>
        <% if (adminSignupEnabled) { %><option value="admin">Admin</option><% } %>
      </select>
    </label>
    <label id="adminCodeField" hidden>Admin Setup Code
      <input type="text" name="admin_code" id="adminCodeInput" autocomplete="off" />
    </label>
    <% if (!adminSignupEnabled) { %>
      <p class="muted" style="font-size: 0.8rem; margin: -0.35rem 0 0;">
        Admin self-registration is currently disabled. New admins must be created from the Admin &gt; Users page.
      </p>
    <% } %>

    <button type="submit" class="btn btn-primary btn-block">Create Account</button>
    <p class="muted login-footer-link">
      Already have an account? <a href="/login">Login</a>
    </p>
  </form>
</div>
<script>
  const roleSelect = document.getElementById('roleSelect');
  const adminCodeField = document.getElementById('adminCodeField');
  const adminCodeInput = document.getElementById('adminCodeInput');
  function syncAdminCodeField() {
    const isAdmin = roleSelect.value === 'admin';
    adminCodeField.hidden = !isAdmin;
    adminCodeInput.required = isAdmin;
  }
  roleSelect.addEventListener('change', syncAdminCodeField);
  syncAdminCodeField();
</script>
<%- include('partials/foot') %>
