<%- include('../partials/head') %>
<%- include('../partials/nav') %>
<main class="container">
  <h1>Inventory</h1>

  <div class="card">
    <h2>Submit Inventory Report</h2>
    <form method="POST" action="/pos/inventory/report" class="form-grid">
      <label>Product
        <select name="product_id" required>
          <% products.forEach(p => { %>
            <option value="<%= p.id %>"><%= p.name %> (<%= p.stock_quantity %> <%= p.unit %> in stock)</option>
          <% }) %>
        </select>
      </label>
      <label>Type
        <select name="type" required>
          <option value="restock">Restock (received new stock)</option>
          <option value="damaged">Damaged</option>
          <option value="lost">Lost / Missing</option>
          <option value="correction">Correction</option>
        </select>
      </label>
      <label>Quantity <input type="number" name="quantity" min="1" required /></label>
      <label>Note <input type="text" name="note" placeholder="Optional remarks" /></label>
      <button type="submit" class="btn btn-primary">Submit Report</button>
    </form>
  </div>

  <div class="card">
    <div class="table-header-bar">
      <h2>Current Stock</h2>
      <div class="table-toolbar">
        <div class="table-search">
          <span class="table-search-icon" aria-hidden="true">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8" /><line x1="21" y1="21" x2="16.65" y2="16.65" /></svg>
          </span>
          <input type="search" data-table-filter="stockTable" placeholder="Filter stock..." aria-label="Filter stock" />
        </div>
        <span class="table-count" data-table-count="stockTable"><%= products.length %> total</span>
        <button type="button" class="btn-export" data-table-export="stockTable" data-export-filename="sari-sari-stock">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" /><polyline points="7 10 12 15 17 10" /><line x1="12" y1="15" x2="12" y2="3" /></svg>
          Export CSV
        </button>
      </div>
    </div>
    <div class="table-scroll table-scroll--tall">
      <table class="table" id="stockTable" data-paginate="10">
        <thead>
          <tr>
            <th data-sort="text">Product</th>
            <th class="num" data-sort="number">Stock</th>
            <th class="num" data-sort="number">Reorder Level</th>
          </tr>
        </thead>
        <tbody>
          <% products.forEach(p => { %>
            <tr class="<%= p.stock_quantity === 0 ? 'row-danger' : (p.stock_quantity <= p.reorder_level ? 'row-warning' : '') %>">
              <td><%= p.name %></td>
              <td class="num"><%= p.stock_quantity %> <%= p.unit %></td>
              <td class="num"><%= p.reorder_level %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>

  <div class="card">
    <h2>My Recent Reports</h2>
    <% if (myReports.length === 0) { %>
      <p class="muted">You haven't submitted any reports yet.</p>
    <% } else { %>
      <div class="table-scroll">
        <table class="table" id="myReportsTable" data-paginate="8">
          <thead>
            <tr>
              <th data-sort="text">Product</th>
              <th data-sort="text">Type</th>
              <th class="num" data-sort="number">Change</th>
              <th data-sort="text">Note</th>
              <th data-sort="text">When</th>
            </tr>
          </thead>
          <tbody>
            <% myReports.forEach(r => { %>
              <tr>
                <td><%= r.product_name %></td>
                <td>
                  <span class="badge <%= r.type === 'restock' ? 'badge-success' : (r.type === 'correction' ? 'badge-info' : 'badge-warning') %>">
                    <%= r.type %>
                  </span>
                </td>
                <td class="num <%= r.quantity_change > 0 ? 'text-success' : 'text-danger' %>">
                  <%= r.quantity_change > 0 ? '+' : '' %><%= r.quantity_change %>
                </td>
                <td class="muted"><%= r.note || '—' %></td>
                <td class="muted"><%= r.created_at %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</main>
<%- include('../partials/foot') %>
