<%- include('../partials/head') %>
<%- include('../partials/nav') %>
<main class="container pos-layout">
  <div class="pos-products">
    <h1>Point of Sale</h1>
    <div class="search-box">
      <span class="search-icon" aria-hidden="true">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8" />
          <line x1="21" y1="21" x2="16.65" y2="16.65" />
        </svg>
      </span>
      <input type="search" id="productSearch" placeholder="Search product or scan barcode..." aria-label="Search product or scan barcode" autofocus />
    </div>
    <div class="product-grid" id="productGrid">
      <% products.forEach(p => { %>
        <button
          type="button"
          class="product-tile"
          data-id="<%= p.id %>"
          data-name="<%= p.name %>"
          data-price="<%= p.selling_price %>"
          data-stock="<%= p.stock_quantity %>"
          data-unit="<%= p.unit %>"
        >
          <span class="product-name"><%= p.name %></span>
          <span class="product-price"><%= peso(p.selling_price) %></span>
          <span class="product-stock"><%= p.stock_quantity %> <%= p.unit %> left</span>
        </button>
      <% }) %>
    </div>
  </div>

  <aside class="pos-cart" aria-label="Shopping cart">
    <div class="cart-header">
      <div class="cart-header-title">
        <h2>Cart</h2>
        <span class="cart-badge" id="cartCount">0 items</span>
      </div>
      <button type="button" class="btn-clear-cart" id="clearCartBtn" hidden>Clear</button>
    </div>

    <div class="cart-list" id="cartBody" role="list"></div>

    <div class="cart-summary">
      <div class="cart-total">
        <span>Total</span>
        <span id="cartTotal">₱0.00</span>
      </div>
    </div>

    <form method="POST" action="/pos/checkout" id="checkoutForm">
      <input type="hidden" name="items" id="itemsInput" />
      <label class="paid-label">Amount Paid
        <div class="currency-input">
          <span class="currency-prefix" aria-hidden="true">₱</span>
          <input type="number" step="0.01" min="0" name="amount_paid" id="amountPaid" placeholder="0.00" inputmode="decimal" required />
        </div>
      </label>

      <div class="quick-cash" id="quickCash" aria-label="Quick cash amounts">
        <button type="button" class="cash-chip cash-chip--exact" data-cash="exact">Exact</button>
        <button type="button" class="cash-chip" data-cash="20">₱20</button>
        <button type="button" class="cash-chip" data-cash="50">₱50</button>
        <button type="button" class="cash-chip" data-cash="100">₱100</button>
        <button type="button" class="cash-chip" data-cash="200">₱200</button>
        <button type="button" class="cash-chip" data-cash="500">₱500</button>
        <button type="button" class="cash-chip" data-cash="1000">₱1,000</button>
      </div>

      <div class="cart-change" id="changeRow">
        <span id="changeLabel">Change</span>
        <span id="changeAmount">₱0.00</span>
      </div>

      <button type="submit" class="btn btn-primary btn-block btn-checkout" id="checkoutBtn" disabled>Complete Sale</button>
    </form>
  </aside>
</main>
<script src="/js/pos.js"></script>
<%- include('../partials/foot') %>
