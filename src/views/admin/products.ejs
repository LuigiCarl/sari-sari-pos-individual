<%- include('../partials/head') %>
<%- include('../partials/nav') %>
<main class="container">
  <h1>Products</h1>

  <div class="grid-2">
    <div class="card">
      <h2>Add Product</h2>
      <form method="POST" action="/admin/products" class="form-grid">
        <label>Name <input type="text" name="name" required /></label>
        <label>Barcode <input type="text" name="barcode" /></label>
        <label>Category
          <select name="category_id">
            <option value="">—</option>
            <% categories.forEach(c => { %><option value="<%= c.id %>"><%= c.name %></option><% }) %>
          </select>
        </label>
        <label>Unit <input type="text" name="unit" value="pc" /></label>
        <label>Cost Price <input type="number" step="0.01" name="cost_price" value="0" /></label>
        <label>Selling Price <input type="number" step="0.01" name="selling_price" required /></label>
        <label>Stock Quantity <input type="number" name="stock_quantity" value="0" /></label>
        <label>Reorder Level <input type="number" name="reorder_level" value="5" /></label>
        <button type="submit" class="btn btn-primary">Add Product</button>
      </form>
    </div>

    <div class="card">
      <h2>Add Category</h2>
      <form method="POST" action="/admin/categories" class="form-inline">
        <input type="text" name="name" placeholder="Category name" required />
        <button type="submit" class="btn btn-secondary">Add</button>
      </form>
      <h2 style="margin-top: 1.5rem;">Existing Categories</h2>
      <ul class="plain-list">
        <% categories.forEach(c => { %><li><%= c.name %></li><% }) %>
      </ul>
    </div>
  </div>

  <div class="card">
    <div class="table-header-bar">
      <h2>All Products</h2>
      <div class="table-toolbar">
        <div class="table-search">
          <span class="table-search-icon" aria-hidden="true">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8" /><line x1="21" y1="21" x2="16.65" y2="16.65" /></svg>
          </span>
          <input type="search" data-table-filter="productsTable" placeholder="Filter products..." aria-label="Filter products" />
        </div>
        <span class="table-count" data-table-count="productsTable"><%= products.length %> total</span>
        <button type="button" class="btn-export" data-table-export="productsTable" data-export-filename="sari-sari-products">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" /><polyline points="7 10 12 15 17 10" /><line x1="12" y1="15" x2="12" y2="3" /></svg>
          Export CSV
        </button>
      </div>
    </div>
    <div class="table-scroll table-scroll--tall">
      <table class="table table-editable" id="productsTable" data-paginate="10">
        <thead>
          <tr>
            <th data-sort="text">Name</th>
            <th data-sort="text">Category</th>
            <th data-sort="text">Unit</th>
            <th class="num" data-sort="number">Cost</th>
            <th class="num" data-sort="number">Price</th>
            <th class="num" data-sort="number">Stock</th>
            <th class="num" data-sort="number">Reorder</th>
            <th data-sort="number">Active</th>
            <th class="col-actions">Action</th>
          </tr>
        </thead>
        <tbody>
          <% products.forEach(p => { %>
            <% const fid = 'product-form-' + p.id %>
            <tr class="<%= !p.active ? 'row-muted' : (p.stock_quantity === 0 ? 'row-danger' : (p.stock_quantity <= p.reorder_level ? 'row-warning' : '')) %>">
              <td><input form="<%= fid %>" type="text" name="name" value="<%= p.name %>" required /></td>
              <td>
                <select form="<%= fid %>" name="category_id">
                  <option value="">—</option>
                  <% categories.forEach(c => { %>
                    <option value="<%= c.id %>" <%= c.id === p.category_id ? 'selected' : '' %>><%= c.name %></option>
                  <% }) %>
                </select>
              </td>
              <td><input form="<%= fid %>" type="text" name="unit" value="<%= p.unit %>" /></td>
              <td class="num"><input form="<%= fid %>" type="number" step="0.01" name="cost_price" value="<%= p.cost_price %>" /></td>
              <td class="num"><input form="<%= fid %>" type="number" step="0.01" name="selling_price" value="<%= p.selling_price %>" /></td>
              <td class="num"><input form="<%= fid %>" type="number" name="stock_quantity" value="<%= p.stock_quantity %>" /></td>
              <td class="num"><input form="<%= fid %>" type="number" name="reorder_level" value="<%= p.reorder_level %>" /></td>
              <td><input form="<%= fid %>" type="checkbox" name="active" value="1" aria-label="Active" <%= p.active ? 'checked' : '' %> /></td>
              <td class="col-actions">
                <form id="<%= fid %>" method="POST" action="/admin/products/<%= p.id %>"></form>
                <button form="<%= fid %>" type="submit" class="btn btn-small btn-save">Save</button>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</main>
<%- include('../partials/foot') %>
